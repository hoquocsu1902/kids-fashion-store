@model KidsFashionStore.Models.ViewModels.Admin.CategoryEditViewModel

@Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })
@Html.HiddenFor(m => m.CategoryId)

<div class="form-row">
    @Html.LabelFor(m => m.CategoryName, new { @class = "lbl" })
    @Html.TextBoxFor(m => m.CategoryName, new { @class = "input", maxlength = 100 })
    @Html.ValidationMessageFor(m => m.CategoryName, "", new { @class = "field-error" })
</div>

<div class="form-row">
    @Html.LabelFor(m => m.ParentId, new { @class = "lbl" })
    @Html.DropDownListFor(m => m.ParentId, (SelectList)ViewBag.ParentList, "-- Không có (danh mục cấp 1) --", new { @class = "input" })
    @Html.ValidationMessageFor(m => m.ParentId, "", new { @class = "field-error" })
    <div class="hint">Menu chỉ hỗ trợ 2 cấp: chỉ danh mục cấp 1 mới được chọn làm cha.</div>
</div>

<div class="form-row">
    @Html.LabelFor(m => m.Description, new { @class = "lbl" })
    @Html.TextBoxFor(m => m.Description, new { @class = "input", maxlength = 255 })
    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "field-error" })
</div>

<div class="form-row">
    <label class="choice">@Html.CheckBoxFor(m => m.IsActive) @Html.DisplayNameFor(m => m.IsActive)</label>
</div>
