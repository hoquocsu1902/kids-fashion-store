@model KidsFashionStore.Models.ViewModels.Admin.PromotionEditViewModel
@{
    ViewBag.Title = "Sửa khuyến mãi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="card">
    @using (Html.BeginForm("Edit", "Promotion", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.Partial("_Form", Model)
        <div class="actions">
            <button type="submit" class="btn btn-primary">Cập nhật</button>
            <a class="btn" href="@Url.Action("Index")">Hủy</a>
        </div>
    }
</div>
@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Html.Partial("_PromotionScript")
}
